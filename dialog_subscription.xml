<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="400dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_search_card"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⭐ ПРЕМИУМ ДОСТУП"
        android:textColor="#FFD700"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Раздел «ФИЛЬМЫ» требует активной подписки. Доступ открывается на 31 день."
        android:textColor="#BBBBCC"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnPayNow"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_search_main_button"
        android:text="ОПЛАТИТЬ 31 ДЕНЬ"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:background="#333344" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Уже есть код активации?"
        android:textColor="#888899"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etPromoCode"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_input"
            android:hint="Введите код..."
            android:paddingStart="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#555566"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnActivateCode"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_selector"
            android:text="ОК"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>